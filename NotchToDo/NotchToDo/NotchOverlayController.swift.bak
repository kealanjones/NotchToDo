        speechClassificationWorkItem?.cancel()
        pendingTranscript = nil
        pendingTaskTitle = nil
        pendingBubbleTargetOrbId = nil
        draggedTaskWindow?.orderOut(nil)
        draggedTaskWindow = nil
        draggedTaskView = nil
